# KRA eTIMS sandbox credentials, used by the examples and `pytest -m live`.
# Copy to .env (git-ignored) and fill in.

# Your KRA PIN (11 characters, e.g. P051234567A)
OSCU_TIN=
# Branch ID: 00 for head office, 01..n for branches
OSCU_BHF_ID=00
# The OSCU device serial number approved by KRA for this PIN and branch
OSCU_DVC_SRL_NO=
# Communication key returned by device initialization (see README)
OSCU_CMC_KEY=
